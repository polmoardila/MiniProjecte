@model Web.Models.EstacioDetall

<div class="container mt-4">
    <div class="text-center mb-5">
        <h1 class="display-4">@Model.Nom</h1>
        <p class="lead text-muted">@Model.Municipi</p>
    </div>
    @if (Model.UltimaMesura != null)
    {
        @* 3. Estado Actual (Métricas) *@
        <div class="row text-center g-4 mb-5">
            <div class="col-md-4">
                <div class="p-4 border rounded shadow-sm">
                    <h6 class="text-uppercase text-muted">Percentatge</h6>
                    <h2 class="display-5 fw-bold">@Model.UltimaMesura.Percentatge.ToString("N1")%</h2>
                    <div class="progress mt-2" style="height: 10px;">
                        <div class="progress-bar bg-primary" style="width: @Model.UltimaMesura.Percentatge.ToString().Replace(",", ".")%"></div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-4 border rounded shadow-sm">
                    <h6 class="text-uppercase text-muted">Volum</h6>
                    <h2 class="display-5">@Model.UltimaMesura.Volum.ToString("N2") <small class="fs-6">hm³</small></h2>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-4 border rounded shadow-sm">
                    <h6 class="text-uppercase text-muted">Nivell</h6>
                    <h2 class="display-5">@Model.UltimaMesura.NivellAbsolut.ToString("N1") <small class="fs-6">msnm</small></h2>
                </div>
            </div>
        </div>

        @* 4. Tabla de Histórico *@
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0">Històric de Mesures</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Data</th>
                            <th>Nivell (msnm)</th>
                            <th>Volum (hm³)</th>
                            <th class="text-end">Percentatge (%)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var h in Model.Historic)
                        {
                            var color = h.Percentatge < 20 ? "text-danger" : h.Percentatge < 50 ? "text-warning" : "text-success";
                            <tr>
                                <td>@h.Data.ToString("dd/MM/yyyy")</td>
                                <td>@h.NivellAbsolut.ToString("N2")</td>
                                <td>@h.Volum.ToString("N2")</td>
                                <td class="text-end fw-bold @color">@h.Percentatge.ToString("N1")%</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center">No hi ha dades per mostrar.</div>
    }
</div>