@model MiniProjecte.Models.Estacio
@using MiniProjecte.Models
@{
    ViewData["Title"] = "Detalls de l'Estació";
    // Buscamos la medida más reciente directamente en la vista
    var mesuraMesNova = Model.Mesures.OrderByDescending(m => m.Data).FirstOrDefault();
}

<div class="apple-container">
    <header class="text-center mb-5">
        <h1 class="display-4 fw-bold">@Model.Nom</h1>
        <p class="text-muted fs-5">@Model.Municipi</p>
        
        @if (mesuraMesNova != null)
        {
            <div class="date-badge">
                Última actualització: <strong>@mesuraMesNova.Data.ToString("dd MMM yyyy")</strong>
            </div>
        }
    </header>

    @if (mesuraMesNova != null)
    {
        <div class="row g-4">
            <div class="col-md-4">
                <div class="metric-card">
                    <span class="label">Nivell Absolut</span>
                    <div class="value">@mesuraMesNova.NivellAbsolut <span class="unit">msnm</span></div>
                </div>
            </div>
            
            <div class="col-md-4">
                <div class="metric-card highlight">
                    <span class="label">Capacitat</span>
                    <div class="value">@mesuraMesNova.Percentatge<span class="unit">%</span></div>
                    <div class="progress-bar-container">
                        <div class="progress-fill" style="width: @mesuraMesNova.Percentatge.ToString().Replace(",", ".")%"></div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="metric-card">
                    <span class="label">Volum Embassat</span>
                    <div class="value">@mesuraMesNova.Volum <span class="unit">hm³</span></div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert-modern"> No s'han trobat dades recents per aquesta estació. </div>
    }
</div>

<style>
    /* Estilos específicos para esta vista (Apple Style) */
    .apple-container { padding: 20px; }
    
    .date-badge {
        display: inline-block;
        background: rgba(0,0,0,0.05);
        padding: 5px 15px;
        border-radius: 20px;
        font-size: 0.9rem;
    }

    .metric-card {
        background: #ffffff;
        border-radius: 24px;
        padding: 30px;
        height: 100%;
        border: 1px solid rgba(0,0,0,0.05);
        transition: transform 0.2s ease;
    }

    .metric-card:hover { transform: translateY(-5px); }

    .metric-card.highlight {
        background: #0071e3;
        color: white;
    }

    .label {
        display: block;
        text-transform: uppercase;
        font-size: 0.75rem;
        font-weight: 700;
        margin-bottom: 10px;
        opacity: 0.7;
    }

    .value { font-size: 2.5rem; font-weight: 700; letter-spacing: -1px; }
    .unit { font-size: 1rem; font-weight: 400; opacity: 0.8; }

    .progress-bar-container {
        background: rgba(255,255,255,0.2);
        height: 6px;
        border-radius: 3px;
        margin-top: 15px;
    }

    .progress-fill { background: white; height: 100%; border-radius: 3px; }

    .alert-modern {
        background: #fef2f2;
        color: #991b1b;
        padding: 20px;
        border-radius: 15px;
        text-align: center;
    }
</style>