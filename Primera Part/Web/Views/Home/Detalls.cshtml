@model Web.Models.EstacioDetall

@{
    ViewData["Title"] = "Detalls de l'Estació";
    // Usamos el nombre exacto de tu modelo
    var m = Model.UltimaMesura;
}

@* Barra de Filtros *@
<div class="filter-bar mb-4 p-4 animate-in">
    <form asp-action="Detalls" method="get" class="row g-3 align-items-end">
        <input type="hidden" name="id" value="@Model.Id" />
        
        <div class="col-md-3">
            <label class="label mb-1">Cercar per Dia</label>
            <input type="date" name="day" class="form-control apple-input" />
        </div>
        
        <div class="col-md-3">
            <label class="label mb-1">Mes</label>
            <select name="month" class="form-select apple-input">
                <option value="">Selecciona mes...</option>
                <option value="1">Gener</option>
                <option value="2">Febrer</option>
                <option value="3">Març</option>
                <option value="4">Abril</option>
                <option value="5">Maig</option>
                <option value="6">Juny</option>
                <option value="7">Juliol</option>
                <option value="8">Agost</option>
                <option value="9">Setembre</option>
                <option value="10">Octubre</option>
                <option value="11">Novembre</option>
                <option value="12">Desembre</option>
            </select>
        </div>

        <div class="col-md-3">
            <label class="label mb-1">Any</label>
            <input type="number" name="year" value="2024" class="form-control apple-input" />
        </div>

        <div class="col-md-3">
            <button type="submit" class="btn-apple-blue w-100">Filtrar Dades</button>
        </div>
    </form>
</div>

<div class="apple-container">
    <header class="text-center mb-5">
        <h1 class="display-4 fw-bold">@Model.Nom</h1>
        <p class="text-muted fs-5">@Model.Municipi</p>
        
        @if (m != null)
        {
            <div class="date-badge">
                Dades de: <strong>@m.Data.ToString("dd MMM yyyy")</strong>
            </div>
        }
    </header>

    @if (m != null)
    {
        <div class="row g-4 mb-5">
            @* NIVEL *@
            <div class="col-md-4">
                <div class="metric-card">
                    <span class="label">Nivell Absolut</span>
                    <div class="value">@m.NivellAbsolut.ToString("N2") <span class="unit">msnm</span></div>
                </div>
            </div>
            
            @* CAPACIDAD *@
            <div class="col-md-4">
                <div class="metric-card highlight">
                    <span class="label">Capacitat</span>
                    <div class="value">@m.Percentatge.ToString("N1")<span class="unit">%</span></div>
                    <div class="progress-bar-container">
                        <div class="progress-fill" style="width: @m.Percentatge.ToString().Replace(",", ".")%"></div>
                    </div>
                </div>
            </div>

            @* VOLUMEN *@
            <div class="col-md-4">
                <div class="metric-card">
                    <span class="label">Volum Embassat</span>
                    <div class="value">@m.Volum.ToString("N2") <span class="unit">hm³</span></div>
                </div>
            </div>
        </div>

        @* TABLA DE HISTÓRICO *@
        <div class="mt-5">
            <h3 class="fw-bold mb-4">Històric de Mesures</h3>
            <div class="apple-card-table">
                <table class="table table-dark table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Data</th>
                            <th>Nivell</th>
                            <th>Volum</th>
                            <th class="text-end">Percentatge</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var h in Model.Historic)
                        {
                            string colorClass = h.Percentatge < 20 ? "text-danger" : 
                                               h.Percentatge < 50 ? "text-warning" : "text-success";
                            <tr>
                                <td class="text-muted">@h.Data.ToString("dd/MM/yyyy")</td>
                                <td>@h.NivellAbsolut.ToString("N2")</td>
                                <td>@h.Volum.ToString("N2")</td>
                                <td class="text-end fw-bold @colorClass">@h.Percentatge.ToString("N2")%</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="alert-modern">No s'han trobat dades per aquesta selecció.</div>
    }
</div>

<style>
    /* Los estilos se mantienen igual para conservar el diseño Apple */
    .filter-bar { background: rgba(255, 255, 255, 0.05); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 24px; }
    .apple-input { background: rgba(255, 255, 255, 0.1) !important; border: 1px solid rgba(255, 255, 255, 0.1) !important; color: white !important; border-radius: 12px; }
    .btn-apple-blue { background: #0071e3; color: white; border-radius: 12px; font-weight: 600; padding: 10px; border: none; transition: 0.2s; }
    .btn-apple-blue:hover { background: #0077ed; }
    .apple-card-table { background: rgba(255, 255, 255, 0.05); border-radius: 24px; overflow: hidden; border: 1px solid rgba(255, 255, 255, 0.1); }
    .table { color: white; margin-bottom: 0; }
    .table thead th { background: rgba(255,255,255,0.05); color: #a1a1a6; border: none; padding: 15px; text-transform: uppercase; font-size: 0.7rem; }
    .table td { padding: 15px; border-color: rgba(255,255,255,0.05); vertical-align: middle; }
    .text-success { color: #30d158 !important; }
    .text-warning { color: #ff9f0a !important; }
    .text-danger { color: #ff453a !important; }
    .apple-container { padding: 20px; color: #ffffff; }
    .metric-card { background: #ffffff; color: #1d1d1f; border-radius: 28px; padding: 30px; height: 100%; border: none; }
    .metric-card.highlight { background: #0071e3; color: #ffffff; }
    .label { display: block; text-transform: uppercase; font-size: 0.75rem; font-weight: 700; margin-bottom: 12px; opacity: 0.6; }
    .value { font-size: 2.8rem; font-weight: 700; letter-spacing: -1px; }
    .unit { font-size: 1.2rem; opacity: 0.7; margin-left: 5px; }
    .progress-bar-container { background: rgba(0, 0, 0, 0.1); height: 8px; border-radius: 4px; margin-top: 20px; overflow: hidden; }
    .highlight .progress-bar-container { background: rgba(255, 255, 255, 0.2); }
    .progress-fill { background: #0071e3; height: 100%; border-radius: 4px; }
    .highlight .progress-fill { background: #ffffff; }
    .alert-modern { background: rgba(255, 255, 255, 0.05); color: #ff453a; padding: 40px; border-radius: 24px; text-align: center; border: 1px solid rgba(255, 69, 58, 0.2); }
    .date-badge { display: inline-block; background: rgba(255, 255, 255, 0.1); color: #ffffff; padding: 5px 15px; border-radius: 20px; font-size: 0.9rem; }
</style>